  "repository": {
    "type": "git",
    "url": "git+https://github.com/SP1R4/noctis-wifi-planner.git"
  },
  "bugs": {
    "url": "https://github.com/SP1R4/noctis-wifi-planner/issues"
  },
  "keywords": [
    "wifi",
    "wi-fi",
    "coverage",
    "planner",
    "site-survey",
    "rf",
    "snr",
    "throughput",
    "mcs",
    "access-point",
    "ip-camera",
    "heatmap",
    "ubiquiti",
    "unifi",
    "mikrotik",
    "aruba",
    "cisco",
    "meraki",
    "ruckus",
    "tp-link",
    "omada",
    "cambium",
    "extreme",
    "engenius",
    "ray-cast",
    "predictive",
    "dfs",
    "channel-planning",
    "poe",
    "vanilla-js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "jsdom": "^22.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
